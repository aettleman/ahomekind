/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The manifest and service worker must never be served stale, or an
# installed app keeps launching with an old start_url.
/manifest.json
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/*/
  Cache-Control: no-cache, must-revalidate
